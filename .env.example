# URL e chave anônima do projeto Supabase (públicas, restritas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (links de formulário, proposta e PDF)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional. Sem esta chave o envio de e-mail fica desligado.
RESEND_API_KEY=
EMAIL_FROM="EMPMED <propostas@seudominio.com.br>"

# Assinatura HMAC da página de impressão usada pelo Puppeteer (válida por 2 minutos).
# Se vazio, o servidor usa SUPABASE_SERVICE_ROLE_KEY como segredo.
PDF_SIGNING_SECRET=

# Opcional. Caminho do Chrome/Chromium local. Na Vercel, deixe vazio
# para usar @sparticuz/chromium.
CHROME_PATH=

# Opcional. Endpoint externo (Browserless ou compatível) se a função
# de PDF na Vercel estourar tempo ou tamanho. Ex.: wss://chrome.browserless.io?token=...
BROWSERLESS_WS_ENDPOINT=
